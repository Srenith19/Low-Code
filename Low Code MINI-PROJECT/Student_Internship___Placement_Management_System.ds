	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Date
			(
    			type = date
				displayname = "Interview Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Status
			(
				type = picklist
				displayname = "Interview Status"
				maxchar = 100
				values = {"Scheduled","Completed","Rescheduled","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_ID
			(
    			type = autonumber
