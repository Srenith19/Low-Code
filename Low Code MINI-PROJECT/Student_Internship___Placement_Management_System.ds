	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Location_Link
			(
    			type = text
				displayname = "Interview Location or Meeting Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Result
			(
				type = picklist
				displayname = "Interview Result"
				maxchar = 100
				values = {"Pending","Passed","Failed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
