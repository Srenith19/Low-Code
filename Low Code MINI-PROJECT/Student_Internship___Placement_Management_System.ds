 application "Student Internship & Placement Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Company_Registration_Form
		{
			title 
    		{
				displayname = "Company Registration Form"
    			on add = "Add Company"
   	 			on edit = "Edit Company"
			}
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Industry
			(
				type = picklist
				maxchar = 100
				values = {"IT","Healthcare","Finance","Manufacturing","Retail","Education","Consulting","Telecommunications","Automotive","Energy"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have HR_Contact_Person
			(
    			type = text
				displayname = "HR Contact Person"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_Website
			(
    			type = url
				displayname = "Company Website"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_ID
			(
    			type = autonumber
				displayname = "Company ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have HR_Email
			(
    			type = email
				displayname = "HR Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company_Name
			(
    			type = text
				displayname = "Company Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_Address
			(
    			type = address
				displayname = "Company Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_Description
			(
    			type = textarea
				displayname = "Company Description"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company_Status
			(
				type = picklist
				displayname = "Company Status"
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have HR_Phone_Number
			(
    			type = phonenumber
				displayname = "HR Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Internship_Application_Form
		{
			displayname = "Internship Application Form"
			success message = "Application submitted successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Internship_Opportunity
			(
				type = picklist	
				displayname = "Internship Opportunity"
				values  = Internship_Opportunity_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Status
			(
				type = picklist
				displayname = "Application Status"
				maxchar = 100
				values = {"Applied","Under Review","Shortlisted","Selected","Rejected","Withdrawn"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cover_Letter
			(
    			type = textarea
				displayname = "Cover Letter"
				height = 5px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recruiter_Remarks
			(
    			type = textarea
				displayname = "Recruiter Remarks"
				height = 4px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Application_ID
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student
			(
				type = picklist	
				values  = Student_Registration_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resume
			(
    			type = upload file
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Internship_Completion_Form
		{
			displayname = "Internship Completion Form"
			success message = "Internship completion recorded successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Company
			(
				type = picklist	
				values  = Company_Registration_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Completion_Status
			(
				type = picklist
				displayname = "Completion Status"
				maxchar = 100
				values = {"In Progress","Completed","Not Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Internship_Application
			(
				type = picklist	
				displayname = "Internship Application"
				values  = Internship_Application_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Internship_End_Date
			(
    			type = date
				displayname = "Internship End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completion_ID
			(
    			type = autonumber
				displayname = "Completion ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certificate_Upload
			(
    			type = upload file
				displayname = "Certificate Upload"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supervisor_Feedback
			(
    			type = textarea
				displayname = "Supervisor Feedback"
				height = 4px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student
			(
				type = picklist	
				values  = Student_Registration_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Internship_Start_Date
			(
    			type = date
				displayname = "Internship Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Internship_Opportunity_Form
		{
			title 
    		{
				displayname = "Internship Opportunity Form"
    			on add = "Add Internship"
