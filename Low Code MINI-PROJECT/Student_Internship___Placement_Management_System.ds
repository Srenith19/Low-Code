:75'\n\tsize = '30px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Placement_Offer_Form.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<panel elementName='Completed_Internships_Card.stat.tinted.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'theme:10'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '24px'\n\tpaddingLeft = '24px'\n\tpaddingRight = '24px'\n\tpaddingBottom = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Completed Internships'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme:75'\n\tsize = '30px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Completion_Status == &quot;Completed&quot;'\n\t  value = 'thisapp.Internship_Completion_Form.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\t\n\ttitle = 'Students by Department'\n\t\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Student_Registration_Form'\n\txfield = 'Department'\n\tyfields = 'count:Student_ID'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Internship Applications by Status'\n\t\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Internship_Application_Form'\n\txfield = 'Application_Status'\n\tyfields = 'count:Application_ID'\n/>\n\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\t\n\ttitle = 'Placement Applications by Status'\n\t\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Placement_Application_Form'\n\txfield = 'Application_Status'\n\tyfields = 'count:Placement_Application_ID'\n/>\n\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Set_Student_Status_Active as "Set Student Status to Active"
			{
				type =  form
				form = Student_Registration_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the Student Status field to 'Active' when the form loads
										input.Student_Status = "Active";
						)
					}
				}

			}
			Set_Placement_Application_Status_Applied as "Set Placement Application Status to Applied"
			{
				type =  form
				form = Placement_Application_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the Application Status field to "Applied" when the form loads
										input.Application_Status = "Applied";
						)
					}
				}

			}
			Set_Interview_Status_Scheduled as "Set Interview Status to Scheduled"
			{
				type =  form
				form = Interview_Schedule_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the Interview_Status field to "Scheduled" on form load
										input.Interview_Status = "Scheduled";
						)
					}
				}

			}
			Set_Placement_Offer_Status_Pending as "Set Placement Offer Status to Pending"
			{
				type =  form
				form = Placement_Offer_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the Offer Status field to 'Pending' when the form loads
										input.Offer_Status = "Pending";
						)
					}
				}

			}
			Set_Internship_Application_Status_Applied as "Set Internship Application Status to Applied"
			{
				type =  form
				form = Internship_Application_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the Application Status field to "Applied" when the form loads
										input.Application_Status = "Applied";
						)
					}
				}

			}
			Placement_Application_Validation as "Placement Application Validation"
			{
				type =  form
				form = Placement_Application_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if Student field is provided
										if(input.Student.isNull())
										{
											alert "Student field is required";
											cancel submit;
										}
										// Check if Job_Opening field is provided
										if(input.Job_Opening.isNull())
										{
											alert "Job Opening field is required";
											cancel submit;
										}
										// Fetch the related Job Opening record to validate status and deadline
										jobRecord = Job_Opening_Form[ID == input.Job_Opening];
										// Validate Job Status is Open
										if(jobRecord.Job_Status != "Open")
										{
											alert "This job opening is no longer available (Status: " + jobRecord.Job_Status + ")";
											cancel submit;
										}
										// Validate Application Deadline has not passed
										if(input.Application_Date > jobRecord.Application_Deadline)
										{
											alert "Application deadline has passed (Deadline: " + jobRecord.Application_Deadline + ")";
											cancel submit;
										}
										// Check for duplicate applications by the same student for the same job
										duplicateCheck = Placement_Application_Form[Student == input.Student && Job_Opening == input.Job_Opening];
										if(duplicateCheck.count() > 0)
										{
											alert "You have already applied for this job opening";
											cancel submit;
										}
										// Validate Resume is uploaded
										if(input.Resume.isNull())
										{
											alert "Resume upload is required";
											cancel submit;
										}
						)
					}
				}

			}
			Placement_Offer_Validation as "Placement Offer Validation"
			{
				type =  form
				form = Placement_Offer_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate required fields and positive salary for Placement Offer submission
										// Check if Student lookup is provided
										if(input.Student.isNull())
										{
											alert(Student,"Student selection is required");
											cancel submit;
										}
										// Check if Company lookup is provided
										if(input.Company.isNull())
										{
											alert(Company,"Company selection is required");
											cancel submit;
										}
										// Check if Offered Position is provided
										if(input.Offered_Position.isBlank())
										{
											alert(Offered_Position,"Offered Position is required");
											cancel submit;
										}
										// Check if Joining Date is provided
										if(input.Joining_Date.isNull())
										{
											alert(Joining_Date,"Joining Date is required");
											cancel submit;
										}
										// Validate Annual Salary Package is positive
										if(input.Annual_Salary_Package.isNull())
										{
											alert(Annual_Salary_Package,"Annual Salary Package is required");
											cancel submit;
										}
										else if(input.Annual_Salary_Package <= 0)
										{
											alert(Annual_Salary_Package,"Annual Salary Package must be a positive value");
											cancel submit;
										}
						)
					}
				}

			}
			Internship_Application_Validation as "Internship Application Validation"
			{
				type =  form
				form = Internship_Application_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate required fields
										if(input.Student.isNull() || input.Internship_Opportunity.isNull() || input.Resume.isNull())
										{
											alert "All required fields (Student, Internship Opportunity, and Resume) must be filled.";
										}
										// Validate Internship Opportunity status
										if(!input.Internship_Opportunity.isNull())
										{
											opportunityRecord = Internship_Opportunity_Form[ID == input.Internship_Opportunity];
											if(opportunityRecord.Internship_Status != "Open")
											{
												alert "The selected internship opportunity is no longer open for applications.";
											}
											// Validate Application Deadline
											if(opportunityRecord.Application_Deadline < zoho.currentdate)
											{
												alert "The application deadline for this internship has passed.";
											}
											// Validate Minimum CGPA if applicable
											if(!opportunityRecord.Minimum_CGPA.isNull() && !input.Student.isNull())
											{
												studentRecord = Student_Registration_Form[ID == input.Student];
												if(studentRecord.CGPA < opportunityRecord.Minimum_CGPA)
												{
													alert "Your CGPA does not meet the minimum requirement for this internship.";
												}
											}
										}
										// Check for duplicate applications by the same student for the same opportunity
										if(!input.Student.isNull() && !input.Internship_Opportunity.isNull())
										{
											duplicateCheck = Internship_Application_Form[Student == input.Student && Internship_Opportunity == input.Internship_Opportunity && ID != input.ID];
											if(duplicateCheck.count() > 0)
											{
												alert "You have already applied for this internship opportunity.";
											}
										}
						)
					}
				}

			}
			Set_Internship_Completion_Status_In_Progress as "Set Internship Completion Status to In Progress"
			{
				type =  form
				form = Internship_Completion_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Check if Completion_Status is empty and set default value
										if(input.Completion_Status.isEmpty())
										{
											input.Completion_Status = "In Progress";
										}
						)
					}
				}

			}
			Set_Interview_Status_to_Scheduled as "Set Interview Status to Scheduled"
			{
				type =  form
				form = Interview_Schedule_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set default Interview Status to 'Scheduled' if the field is empty
										if(input.Interview_Status.isNull() || input.Interview_Status.isEmpty())
										{
											input.Interview_Status = "Scheduled";
										}
						)
					}
				}

			}
		}






