	 			row = 1
	 			column = 1   
				width = medium
			)
			Eligible_Departments
			(
    			type = textarea
				displayname = "Eligible Departments"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Internship_Type
			(
				type = picklist
				displayname = "Internship Type"
				maxchar = 100
				values = {"Remote","On-site","Hybrid"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internship_ID
			(
    			type = autonumber
				displayname = "Internship ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Required_Skills
			(
    			type = textarea
				displayname = "Required Skills"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internship_Start_Date
			(
    			type = date
				displayname = "Internship Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internship_Description
			(
    			type = textarea
				displayname = "Internship Description"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Internship_Title
			(
    			type = text
				displayname = "Internship Title"
	 			row = 1
	 			column = 1   
