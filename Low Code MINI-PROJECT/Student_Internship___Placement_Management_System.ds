			)
			must have Company
			(
				type = picklist	
				values  = Company_Registration_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Time
			(
    			type = time
				displayname = "Interview Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Mode
			(
				type = picklist
				displayname = "Interview Mode"
				maxchar = 100
				values = {"Online","Offline"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Type
			(
				type = picklist
				displayname = "Application Type"
				maxchar = 100
				values = {"Internship","Placement"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student
			(
				type = picklist	
				values  = Student_Registration_Form.ID
