					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Placement_Offer_Form
		{
			displayname = "Placement Offer Form"
			success message = "Offer details added successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Company
			(
				type = picklist	
				values  = Company_Registration_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Joining_Date
			(
    			type = date
				displayname = "Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Offer_ID
			(
    			type = autonumber
				displayname = "Offer ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Offered_Position
			(
    			type = text
				displayname = "Offered Position"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Annual_Salary_Package
			(
				displayname = "Annual Salary Package"
				type = INR
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Offer_Status
			(
				type = picklist
				displayname = "Offer Status"
				maxchar = 100
				values = {"Pending","Accepted","Declined","Withdrawn"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student
			(
				type = picklist	
				values  = Student_Registration_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Related_Job_Application
			(
				type = picklist	
				displayname = "Related Job Application"
				values  = Placement_Application_Form.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Offer_Date
			(
    			type = date
				displayname = "Offer Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Student_Registration_Form
		{
			title 
    		{
				displayname = "Student Registration Form"
    			on add = "Add Student"
   	 			on edit = "Edit Student"
			}
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Graduation_Year
			(
				type = number
				displayname = "Graduation Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			LinkedIn_Profile_URL
			(
    			type = url
				displayname = "LinkedIn Profile URL"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Degree
			(
				type = picklist
				maxchar = 100
				values = {"B.Tech","B.E","M.Tech","M.E","B.Sc","M.Sc","BCA","MCA"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certifications
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Phone_Number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have CGPA
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Programming_Languages
			(
    			type = textarea
				displayname = "Programming Languages"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Current_Semester
			(
				type = number
				displayname = "Current Semester"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student_Status
			(
				type = picklist
				displayname = "Student Status"
				maxchar = 100
				values = {"Active","Graduated","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Backlogs_Count
			(
				type = number
				displayname = "Backlogs Count"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technical_Skills
			(
    			type = textarea
				displayname = "Technical Skills"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Full_Name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Register_Number
			(
    			type = text
				displayname = "Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist
				maxchar = 100
				values = {"Computer Science","Electronics","Mechanical","Civil","Information Technology","Electrical","Biotechnology","Chemical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Student_ID
			(
    			type = autonumber
				displayname = "Student ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			GitHub_Profile_URL
			(
    			type = url
				displayname = "GitHub Profile URL"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resume_Upload
			(
    			type = upload file
				displayname = "Resume Upload"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list Internship_Completions
		{
			displayName = "Internship Completions"
			show all rows from Internship_Completion_Form    
			(
				Completion_ID as "Completion ID"
				Student
				Company
				Internship_Start_Date as "Internship Start Date"
				(
					displayformat = fulldate
				)
				Internship_End_Date as "Internship End Date"
				(
					displayformat = fulldate
				)
				Completion_Status as "Completion Status"
				Internship_Application as "Internship Application"
				Supervisor_Feedback as "Supervisor Feedback"
				Certificate_Upload as "Certificate Upload"
			)
			sort by
			(
				Internship_End_Date descending
			)
		}
		list Internship_List
		{
			displayName = "Internship List"
			show all rows from Internship_Opportunity_Form    
			(
				Internship_Title as "Internship Title"
				Internship_ID as "Internship ID"
				Company
				Internship_Type as "Internship Type"
				Internship_Status as "Internship Status"
				Internship_Start_Date as "Internship Start Date"
				(
					displayformat = fulldate
				)
				Internship_End_Date as "Internship End Date"
				(
					displayformat = fulldate
				)
				Available_Positions as "Available Positions"
				Stipend_Amount as "Stipend Amount"
				(
					display = average	
				)
				Internship_Duration as "Internship Duration"
				Minimum_CGPA as "Minimum CGPA"
				Maximum_Backlogs_Allowed as "Maximum Backlogs Allowed"
				Application_Deadline as "Application Deadline"
				(
					displayformat = fulldate
				)
				Eligible_Departments as "Eligible Departments"
				Required_Skills as "Required Skills"
				Internship_Description as "Internship Description"
			)
			sort by
			(
				Internship_Start_Date ascending
			)
		}
		list Job_List
		{
			displayName = "Job List"
			show all rows from Job_Opening_Form    
			(
				Job_Title as "Job Title"
				Job_ID as "Job ID"
				Company
				Job_Type as "Job Type"
				Job_Status as "Job Status"
				Work_Location as "Work Location"
				Annual_Salary_Package as "Annual Salary Package"
				(
					display = average	
				)
				Application_Deadline as "Application Deadline"
				(
					displayformat = fulldate
				)
				Available_Positions as "Available Positions"
				Minimum_CGPA as "Minimum CGPA"
				Maximum_Backlogs_Allowed as "Maximum Backlogs Allowed"
				Eligible_Departments as "Eligible Departments"
				Required_Skills as "Required Skills"
				Job_Description as "Job Description"
			)
			sort by
			(
				Application_Deadline ascending
			)
		}
		list Internship_Applications
		{
			displayName = "Internship Applications"
			show all rows from Internship_Application_Form    
			(
				Application_ID as "Application ID"
				Student
				Internship_Opportunity as "Internship Opportunity"
				Application_Date as "Application Date"
				(
					displayformat = fulldate
				)
				Application_Status as "Application Status"
				Cover_Letter as "Cover Letter"
				Recruiter_Remarks as "Recruiter Remarks"
				Resume
			)
			sort by
			(
				Application_Date descending
			)
		}
		list Company_List
		{
			displayName = "Company List"
			show all rows from Company_Registration_Form    
			(
				Company_Name as "Company Name"
				Company_ID as "Company ID"
				Industry
				HR_Contact_Person as "HR Contact Person"
				HR_Email as "HR Email"
				HR_Phone_Number as "HR Phone Number"
				(
					displayformat = formattednumber 
				)
				Company_Status as "Company Status"
				Company_Website as "Company Website"
				Company_Description as "Company Description"
				Company_Address  as "Company Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			sort by
			(
				Company_Name ascending
			)
		}
		list Placement_Offers
		{
			displayName = "Placement Offers"
			show all rows from Placement_Offer_Form    
			(
				Offer_ID as "Offer ID"
				Student
				Company
				Offered_Position as "Offered Position"
				Offer_Date as "Offer Date"
				(
					displayformat = fulldate
				)
				Offer_Status as "Offer Status"
				Annual_Salary_Package as "Annual Salary Package"
				(
					display = average	
				)
				Joining_Date as "Joining Date"
				(
					displayformat = fulldate
				)
				Related_Job_Application as "Related Job Application"
			)
			sort by
			(
				Offer_Date descending
			)
		}
		list Interview_List
		{
			displayName = "Interview List"
			show all rows from Interview_Schedule_Form    
			(
				Interview_ID as "Interview ID"
				Student
				Company
				Interview_Date as "Interview Date"
				(
					displayformat = fulldate
				)
				Interview_Time as "Interview Time"
				Interview_Round as "Interview Round"
				Application_Type as "Application Type"
				Interview_Status as "Interview Status"
				Interview_Mode as "Interview Mode"
				Interview_Location_Link as "Interview Location or Meeting Link"
				Related_Application as "Related Application"
				Interview_Feedback as "Interview Feedback"
				Interview_Result as "Interview Result"
			)
			sort by
			(
				Interview_Date ascending
			)
		}
		list Student_List
		{
			displayName = "Student List"
			show all rows from Student_Registration_Form    
			(
				Full_Name  as "Full Name"
				Register_Number as "Register Number"
				Email_Address as "Email Address"
				Phone_Number as "Phone Number"
				(
					displayformat = formattednumber 
				)
				Department
				Student_Status as "Student Status"
				CGPA
				(
					display = average	
				)
				Graduation_Year as "Graduation Year"
				Current_Semester as "Current Semester"
				Backlogs_Count as "Backlogs Count"
				Degree
				Technical_Skills as "Technical Skills"
				Programming_Languages as "Programming Languages"
				Certifications
				LinkedIn_Profile_URL as "LinkedIn Profile URL"
				GitHub_Profile_URL as "GitHub Profile URL"
				Resume_Upload as "Resume Upload"
			)
			sort by
			(
				Full_Name.first_name ascending
			)
		}
		list Placement_Applications
		{
			displayName = "Placement Applications"
			show all rows from Placement_Application_Form    
			(
				Placement_Application_ID as "Placement Application ID"
				Student
				Job_Opening as "Job Opening"
				Application_Date as "Application Date"
				(
					displayformat = fulldate
				)
				Application_Status as "Application Status"
				Recruiter_Remarks as "Recruiter Remarks"
				Resume
			)
			sort by
			(
				Application_Date descending
			)
		}
	}
	pages
	{
		page Student_Placement_Dashboard
		{
			displayname = "Student Placement Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Total_Students_Card.stat.tinted.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'theme:10'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '24px'\n\tpaddingLeft = '24px'\n\tpaddingRight = '24px'\n\tpaddingBottom = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Students'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme:75'\n\tsize = '30px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Student_Registration_Form.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Total_Companies_Card.stat.tinted.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'theme:10'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '24px'\n\tpaddingLeft = '24px'\n\tpaddingRight = '24px'\n\tpaddingBottom = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Companies'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme:75'\n\tsize = '30px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Company_Registration_Form.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<panel elementName='Total_Internship_Apps_Card.stat.tinted.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'theme:10'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '24px'\n\tpaddingLeft = '24px'\n\tpaddingRight = '24px'\n\tpaddingBottom = '24px'\n\n\t\twidth = '100%'